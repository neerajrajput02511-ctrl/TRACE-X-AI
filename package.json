{
  "name": "trace-x",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "preview": "node server/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "user": "node --env-file-if-exists=.env server/user.mjs",
    "build:offline": "node scripts/offline.mjs",
    "demo": "node --env-file-if-exists=.env server/demo.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "node scripts/check.mjs",
    "e2e": "node scripts/e2e.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "build": "node scripts/vendor.mjs && node scripts/offline.mjs",
    "e2e:ui": "node tests/browser.e2e.mjs",
    "e2e:launch": "node tests/workspace-launch.e2e.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cytoscape": "^3.35.0",
    "leaflet": "^1.9.4",
    "pdfkit": "^0.21.0",
    "read-excel-file": "^9.3.20",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.65.1"
  }
}
